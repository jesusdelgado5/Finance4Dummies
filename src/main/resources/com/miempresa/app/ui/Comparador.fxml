<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.miempresa.app.ui.ComparadorController"
      spacing="15" alignment="TOP_CENTER" style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <Label text="Comparador de Productos" styleClass="form-title"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
        </columnConstraints>

        <Label text="Producto A:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboA" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Producto B:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboB" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Button text="Comparar"
                onAction="#onCompare"
                styleClass="btn-primary"
                GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
    </GridPane>

    <BarChart fx:id="comparisonChart"
              title="Comparación de Costo vs Principal"
              categoryGap="150" barGap="20"
              prefHeight="400" prefWidth="0.0" maxWidth="Infinity"
              VBox.vgrow="ALWAYS">
        <xAxis>
            <CategoryAxis fx:id="xAxis"
                          label="Métrica"
                          tickLabelRotation="90"/>
        </xAxis>
        <yAxis>
            <NumberAxis fx:id="yAxis" label="Valor"/>
        </yAxis>
    </BarChart>

    <Button text="Volver al Menú"
            onAction="#onBackToMenu"
            styleClass="btn-secondary"/>
</VBox>
