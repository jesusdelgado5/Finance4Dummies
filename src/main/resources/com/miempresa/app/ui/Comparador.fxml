<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.miempresa.app.ui.ComparadorController"
      spacing="15" alignment="TOP_CENTER" styleClass="root-pane2">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <Label text="Comparador de Inversiones" styleClass="form-title"/>

    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
        </columnConstraints>

        <Label text="Inversión A:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboA"
                  promptText="Selecciona A"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Inversión B:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboB"
                  promptText="Selecciona B"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <HBox spacing="15" alignment="CENTER"
              GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4">
            <Button text="Comparar"
                    fx:id="compareButton"
                    onAction="#onCompare"
                    styleClass="btn-tertiary"/>
            <Button text="Limpiar"
                    fx:id="clearButton"
                    onAction="#onClear"
                    styleClass="btn-clear"/>
            <Button text="Volver al Menú"
                    fx:id="backButton"
                    onAction="#onBackToMenu"
                    styleClass="btn-clear"/>
        </HBox>
    </GridPane>

    <TextArea fx:id="detailsArea"
              editable="false"
              wrapText="true"
              prefRowCount="10"
              prefHeight="200"
              styleClass="output-area"
              style="-fx-font-size:16px; -fx-font-weight:bold;"
              VBox.vgrow="ALWAYS"
              promptText="Aquí se mostrarán las comparaciones de inversiones"/>
</VBox>
