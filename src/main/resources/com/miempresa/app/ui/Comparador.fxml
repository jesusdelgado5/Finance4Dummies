<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.miempresa.app.ui.ComparadorController"
      spacing="15" alignment="TOP_CENTER"
      style="-fx-background-color: #f5f5f5;">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <Label text="Comparador de Productos" styleClass="form-title"/>

    <!-- Selector de tipo de producto -->
    <HBox spacing="10" alignment="CENTER">
        <Label text="Tipo:"/>
        <ComboBox fx:id="typeCombo"
                  promptText="Elige tipo"
                  prefWidth="200"/>
    </HBox>

    <!-- Selección de los dos productos a comparar -->
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="20"/>
            <ColumnConstraints percentWidth="30"/>
        </columnConstraints>

        <Label text="Producto A:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboA"
                  GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Producto B:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="comboB"
                  GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Button text="Comparar"
                onAction="#onCompare"
                styleClass="btn-tertiary"
                GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2"/>
        <Button text="Limpiar"
                onAction="#onClear"
                styleClass="btn-clear"
                GridPane.rowIndex="2" GridPane.columnIndex="2" GridPane.columnSpan="2"/>
    </GridPane>

    <!-- Detalles comparativos en texto -->
    <TextArea fx:id="detailsArea"
              editable="false"
              wrapText="true"
              prefRowCount="5"
              styleClass="details-area"
              VBox.vgrow="NEVER"/>

    <!-- Gráfica de evolución mensual -->
    <LineChart fx:id="lineChart"
               title="Evolución Mensual"
               prefHeight="400"
               maxWidth="Infinity"
               VBox.vgrow="ALWAYS"
               animated="false"
               createSymbols="true">
        <xAxis>
            <NumberAxis label="Mes" fx:id="xAxis"/>
        </xAxis>
        <yAxis>
            <NumberAxis label="Valor" fx:id="yAxis"/>
        </yAxis>
    </LineChart>

    <HBox spacing="15">
        <Button text="Volver al Menú"
                onAction="#onBackToMenu"
                styleClass="btn-clear"/>
    </HBox>
</VBox>
