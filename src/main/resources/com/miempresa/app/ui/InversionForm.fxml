<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.miempresa.app.ui.InversionController"
      spacing="15" alignment="TOP_CENTER" styleClass="root-pane2">
    <padding>
        <Insets top="20" right="30" bottom="20" left="30"/>
    </padding>

    <Label text="Gestión de Inversiones" styleClass="form-title"/>

    <GridPane hgap="10" vgap="5">
        <columnConstraints>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="40"/>
            <ColumnConstraints percentWidth="30"/>
        </columnConstraints>

        <Label text="Nombre Inversión:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="Fondo X" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
        <Label fx:id="nameErrorLabel" visible="false" styleClass="error-label" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

        <Label text="Monto Inicial:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="amountField" promptText="1000.00" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
        <Label fx:id="amountErrorLabel" visible="false" styleClass="error-label" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

        <Label text="Tasa Anual (%):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="rateField2" promptText="5" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        <Label fx:id="rateErrorLabel" visible="false" styleClass="error-label" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

        <Label text="Plazo (meses):" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="termField2" promptText="12" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
        <Label fx:id="termErrorLabel" visible="false" styleClass="error-label" GridPane.rowIndex="3" GridPane.columnIndex="2"/>

        <Label text="Compuesta:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <CheckBox fx:id="compoundCheckBox" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <Label text="Fecha Inicio:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <DatePicker fx:id="startDatePicker2" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
        <Label fx:id="startDateErrorLabel" visible="false" styleClass="error-label" GridPane.rowIndex="5" GridPane.columnIndex="2"/>
    </GridPane>

    <HBox spacing="15">
        <Button text="Calcular Rentabilidad" onAction="#onCalculateReturn" styleClass="btn-tertiary"/>
        <Button text="Proyección de Valor" onAction="#onGenerateProjection" styleClass="btn-tertiary"/>
        <Button text="Limpiar" onAction="#onClear" styleClass="btn-clear"/>
        <Button text="Volver al Menú" onAction="#onBackToMenu2" styleClass="btn-clear"/>
    </HBox>

    <!-- Área de resultados -->
    <TextArea fx:id="resultsArea"
              promptText="Aquí se mostrarán las ganancias mes a mes y total"
              prefRowCount="8"
              wrapText="true"
              styleClass="output-area"/>
</VBox>
