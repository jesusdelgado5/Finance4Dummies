<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Label?>

<StackPane fx:id="root" style="-fx-background-color: transparent;" stylesheets="@style.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.miempresa.app.ui.MainMenuController">

    <!-- Imagen de fondo siempre al 100% -->
    <ImageView fx:id="bgView" fitHeight="600.0" fitWidth="800.0" preserveRatio="false" StackPane.alignment="CENTER">
        <image>
            <Image url="@../resources/menu_bg.png" />
        </image>
    </ImageView>

    <Label fx:id="titleLabel"
           text="Finance4Dummies"
           styleClass="title-crayon"
           StackPane.alignment="CENTER"
           translateY="50"/>

    <!-- HBox centrado que contiene dos VBoxes -->
    <HBox alignment="CENTER" style="-fx-padding: 0 50 0 50;" translateY="200" StackPane.alignment="CENTER">

        <!-- Primer VBox con los dos primeros botones (izquierda) -->
        <VBox alignment="CENTER" spacing="20" translateX="100" HBox.hgrow="ALWAYS">
            <Button fx:id="btnTarjetas" onAction="#goToTarjetas" styleClass="btn-animated" text="Tarjetas de Crédito">
                <font><Font name="Eras Bold ITC" size="20.0" /></font>
            </Button>
            <Button fx:id="btnPrestamos" onAction="#goToPrestamos" styleClass="btn-animated" text="Préstamos Bancarios">
                <font><Font name="Eras Bold ITC" size="20.0" /></font>
            </Button>
        </VBox>

        <!-- Segundo VBox con los dos botones restantes (derecha) -->
        <VBox alignment="CENTER" spacing="20" translateX="-100" HBox.hgrow="ALWAYS">
            <Button fx:id="btnInversiones" onAction="#goToInversiones" styleClass="btn-animated" text="Inversión en Bolsa">
                <font><Font name="Eras Bold ITC" size="20.0" /></font>
            </Button>
            <Button fx:id="btnComparador" onAction="#goToComparador" styleClass="btn-animated" text="Comparar Inversiones">
                <font><Font name="Eras Bold ITC" size="20.0" /></font>
            </Button>
        </VBox>

    </HBox>
</StackPane>

