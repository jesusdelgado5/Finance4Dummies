<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/17"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.miempresa.app.ui.StartPageController"
           styleClass="start-pane">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <!-- Contenedor vertical centrado -->
    <VBox spacing="20" alignment="CENTER">
        <!-- Logos -->
        <HBox spacing="50" alignment="CENTER">
            <ImageView fx:id="logoUni" fitHeight="100" preserveRatio="true">
                <image>
                    <Image url="@../resources/logo_utp.png"/>
                </image>
            </ImageView>
            <ImageView fx:id="logoFac" fitHeight="100" preserveRatio="true">
                <image>
                    <Image url="@../resources/logo_fisc.png"/>
                </image>
            </ImageView>
        </HBox>

        <!-- Títulos centrados -->
        <Label text="Universidad Tecnológica de Panamá"
               styleClass="presentation-title"
               alignment="CENTER"
               textAlignment="CENTER"/>
        <Label text="Facultad de Ingeniería en Sistemas Computacionales"
               styleClass="presentation-subtitle"
               alignment="CENTER"
               textAlignment="CENTER"/>
        <Separator prefWidth="600"/>

        <!-- Datos del proyecto centrados -->
        <VBox spacing="10" alignment="CENTER">
            <Label text="Carrera: Licenciatura en Ingeniería de Software"
                   styleClass="presentation-text"
                   alignment="CENTER"
                   textAlignment="CENTER"/>
            <Label text="Grupo: 1SF121"
                   styleClass="presentation-text"
                   alignment="CENTER"
                   textAlignment="CENTER"/>
            <Label text="Integrantes:"
                   styleClass="presentation-text"
                   alignment="CENTER"
                   textAlignment="CENTER"/>
            <Label text="– Jesús Delgado E-8-223537"
                   styleClass="presentation-text"
                   alignment="CENTER"
                   textAlignment="CENTER"/>
            <Label text="– Moisés Gálvez 8-1024-1285"
                   styleClass="presentation-text"
                   alignment="CENTER"
                   textAlignment="CENTER"/>
            <Label text="– Joseph Wu 8-1021-2217"
                   styleClass="presentation-text"
                   alignment="CENTER"
                   textAlignment="CENTER"/>
            <Label text="Profesor: Rodrigo Yángüez"
                   styleClass="presentation-text"
                   alignment="CENTER"
                   textAlignment="CENTER"/>
            <Label text="Fecha de entrega: 30 de julio de 2025"
                   styleClass="presentation-text"
                   alignment="CENTER"
                   textAlignment="CENTER"/>
        </VBox>

        <!-- Botón para iniciar centrado -->
        <Button text="Ingresar"
                fx:id="startButton"
                onAction="#onStart"
                styleClass="btn-tertiary"/>
    </VBox>
</StackPane>
